{
  "repo": "<owner/repo>",
  "coordinates": "<one line: what workstreams this repo coordinates>",
  "board": "<owner/repo where this repo's deciders' pinned board is published>",
  "seats": [
    {
      "label": "<LABEL>",
      "role": "<what this seat owns>",
      "repo": "<owner/repo it works in>",
      "lane": "app",
      "github": "<login>",
      "tracking": "<owner/repo#N>",
      "home": { "kind": "checkout", "branch": null }
    }
  ],
  "people": [
    {
      "github": "<login>",
      "name": "<name>",
      "role": "<maintainer | collaborator | owner>"
    }
  ],
  "license": {
    "name": "<display name, e.g. Acme Community License, version 1>",
    "file": "LICENSE.md",
    "manifest": "SEE LICENSE IN LICENSE.md",
    "source": {
      "repo": "<owner/repo of the canonical source>",
      "path": "<path of the source in it>",
      "render": "pandoc -f latex -t markdown_strict --wrap=none"
    }
  }
}
